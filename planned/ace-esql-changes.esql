-- Replace these modules in FundTransferFlow_Compute.esql.
-- Other modules (DebitFailed, DebitUncertain, CreditUncertain, CompensationFailed)
-- can stay as they are. Add the same transferId line to them if you want it in every reply.
--
-- If the Toolkit flags UUIDASCHAR as unknown, replace it with a fixed text
-- and require callers to send transferId.

CREATE COMPUTE MODULE PrepareDebit
  CREATE FUNCTION Main() RETURNS BOOLEAN
  BEGIN
    -- Use the caller's transferId (so retries are safe), or make one
    DECLARE tid CHARACTER;
    SET tid = COALESCE(CAST(InputRoot.JSON.Data.transferId AS CHARACTER), UUIDASCHAR);

    SET Environment.Variables.SourceAccount =
      InputRoot.JSON.Data.sourceAccount;
    SET Environment.Variables.DestinationAccount =
      InputRoot.JSON.Data.destinationAccount;
    SET Environment.Variables.TransferAmount =
      InputRoot.JSON.Data.amount;
    SET Environment.Variables.TransferId = tid;

    SET OutputLocalEnvironment = InputLocalEnvironment;
    SET OutputRoot = NULL;
    SET OutputRoot.HTTPRequestHeader."Content-Type" = 'application/json';
    CREATE LASTCHILD OF OutputRoot DOMAIN('JSON');

    SET OutputRoot.JSON.Data.amount = Environment.Variables.TransferAmount;
    SET OutputRoot.JSON.Data.transferId = tid;

    SET OutputLocalEnvironment.Destination.HTTP.RequestURL =
      'http://localhost:3000/accounts/'
      || CAST(Environment.Variables.SourceAccount AS CHARACTER)
      || '/debit';
    SET OutputLocalEnvironment.Destination.HTTP.RequestLine.Method = 'POST';

    RETURN TRUE;
  END;
END MODULE;


CREATE COMPUTE MODULE PrepareCredit
  CREATE FUNCTION Main() RETURNS BOOLEAN
  BEGIN
    SET OutputLocalEnvironment = InputLocalEnvironment;
    SET OutputRoot = NULL;
    SET OutputRoot.HTTPRequestHeader."Content-Type" = 'application/json';
    CREATE LASTCHILD OF OutputRoot DOMAIN('JSON');

    SET OutputRoot.JSON.Data.amount = Environment.Variables.TransferAmount;
    SET OutputRoot.JSON.Data.transferId = Environment.Variables.TransferId;
    SET OutputRoot.JSON.Data.operation = 'CREDIT';

    SET OutputLocalEnvironment.Destination.HTTP.RequestURL =
      'http://localhost:3000/accounts/'
      || CAST(Environment.Variables.DestinationAccount AS CHARACTER)
      || '/credit';
    SET OutputLocalEnvironment.Destination.HTTP.RequestLine.Method = 'POST';

    RETURN TRUE;
  END;
END MODULE;


CREATE COMPUTE MODULE PrepareRefund
  CREATE FUNCTION Main() RETURNS BOOLEAN
  BEGIN
    SET OutputLocalEnvironment = InputLocalEnvironment;
    SET OutputRoot = NULL;
    SET OutputRoot.HTTPRequestHeader."Content-Type" = 'application/json';
    CREATE LASTCHILD OF OutputRoot DOMAIN('JSON');

    SET OutputRoot.JSON.Data.amount = Environment.Variables.TransferAmount;
    SET OutputRoot.JSON.Data.transferId = Environment.Variables.TransferId;
    SET OutputRoot.JSON.Data.operation = 'REFUND';

    SET OutputLocalEnvironment.Destination.HTTP.RequestURL =
      'http://localhost:3000/accounts/'
      || CAST(Environment.Variables.SourceAccount AS CHARACTER)
      || '/credit';
    SET OutputLocalEnvironment.Destination.HTTP.RequestLine.Method = 'POST';

    RETURN TRUE;
  END;
END MODULE;


CREATE COMPUTE MODULE TransferSuccess
  CREATE FUNCTION Main() RETURNS BOOLEAN
  BEGIN
    SET OutputLocalEnvironment = InputLocalEnvironment;
    SET OutputRoot = NULL;
    CREATE LASTCHILD OF OutputRoot DOMAIN('JSON');

    SET OutputRoot.JSON.Data.status = 'SUCCESS';
    SET OutputRoot.JSON.Data.message = 'Transfer completed';
    SET OutputRoot.JSON.Data.amount = Environment.Variables.TransferAmount;
    SET OutputRoot.JSON.Data.transferId = Environment.Variables.TransferId;

    SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 200;
    RETURN TRUE;
  END;
END MODULE;


CREATE COMPUTE MODULE TransferRefunded
  CREATE FUNCTION Main() RETURNS BOOLEAN
  BEGIN
    SET OutputLocalEnvironment = InputLocalEnvironment;
    SET OutputRoot = NULL;
    CREATE LASTCHILD OF OutputRoot DOMAIN('JSON');

    SET OutputRoot.JSON.Data.status = 'FAILED_REFUNDED';
    SET OutputRoot.JSON.Data.message =
      'Credit failed; source account refund completed';
    SET OutputRoot.JSON.Data.transferId = Environment.Variables.TransferId;

    SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 502;
    RETURN TRUE;
  END;
END MODULE;
